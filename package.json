{
  "name": "arkane-daw",
  "productName": "ArkaneDAW",
  "version": "0.3.4",
  "description": "ArkaneDAW - a pattern-based digital audio workstation",
  "main": "./out/main/index.js",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/elevchyt/ArkaneDAW"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "catalog": "UPDATE_CATALOG=1 vitest run src/renderer/src/plugins/catalog-doc.test.ts",
    "build:native": "bash native/build.sh",
    "test:native": "bash native/build.sh --test",
    "drumkits": "node scripts/drumkits/build.mjs",
    "concerto": "node scripts/concerto/build.mjs",
    "packs": "node scripts/packs/build.mjs all",
    "pack:concerto": "node scripts/packs/build.mjs concerto",
    "pack:studiodrums": "node scripts/packs/build.mjs studiodrums",
    "dist:linux": "electron-vite build && electron-builder --linux --publish never",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "dist": "electron-vite build && electron-builder --linux --win --publish never"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "immer": "^11.1.21",
    "lucide-react": "^1.54.0",
    "nanoid": "^6.0.2",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "resedit": "^2.0.3",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9",
    "vite": "^7.3.7",
    "vitest": "^3.2.7",
    "zustand": "^5.0.15"
  },
  "author": {
    "name": "elevchyt"
  },
  "homepage": "https://github.com/elevchyt/ArkaneDAW",
  "desktopName": "arkanedaw.desktop"
}
